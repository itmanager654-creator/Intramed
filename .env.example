# Neon Postgres (Vercel: Storage > Marketplace > Neon sets this automatically)
DATABASE_URL=

# Vercel Blob (Vercel: Storage > Blob sets this automatically)
BLOB_READ_WRITE_TOKEN=

# Admin login
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=any-long-random-string


# Browser/phone push notifications: run  node scripts/gen-vapid.mjs  and paste the two lines it prints
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: Google Search Console HTML-tag verification code
GOOGLE_SITE_VERIFICATION=
